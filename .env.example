# StaffSync Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Provide your MongoDB connection string (e.g., local MongoDB or MongoDB Atlas URI)
# If local mongod is not installed/running, StaffSync falls back automatically to an in-memory MongoDB instance for development & testing!
MONGODB_URI=mongodb://127.0.0.1:27017/staffsync

# JWT Authentication
JWT_SECRET=staffsync_super_secret_jwt_key_change_in_production_2025
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Demo account passwords (development/demo only).
# Each demo account script reads its password from these variables at setup time.
# The password is hashed with bcryptjs (User model pre-save hook) and never stored plainly.
# Examples (Windows PowerShell):
#   $env:STAFFSYNC_HR_PASSWORD="your_temp_password"
#   $env:STAFFSYNC_MANAGER_PASSWORD="your_temp_password"
#   $env:STAFFSYNC_STAFF_PASSWORD="your_temp_password"
STAFFSYNC_HR_PASSWORD=
STAFFSYNC_MANAGER_PASSWORD=
STAFFSYNC_STAFF_PASSWORD=

# System Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
